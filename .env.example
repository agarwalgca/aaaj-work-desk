# Supabase project (region ap-southeast-1). Both values are safe in the client
# bundle: the anon key is public and every table is guarded by RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used only by scripts/ (RLS assertions, seeding) — never imported by src/.
# Keep this out of .env and out of git; it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# The password the seeded @seed.aaaj.co.in accounts were created with. Needed by
# scripts/test-rls.ts and scripts/verify-live.mjs to sign in as a manager and a
# member of staff. Never commit it — a working manager password in a public repo
# is a way into the firm's data.
SEED_PASSWORD=

# Optional: lets scripts/test-rls.ts run the partner cases too.
PARTNER_USERNAME=
PARTNER_PASSWORD=
